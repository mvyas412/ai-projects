# Application
APP_ENV=development
LOG_LEVEL=INFO
MM_RAG_API_URL=http://127.0.0.1:8000

# OpenAI (set real values only in the ignored .env file)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_DB=mm_rag_phase2
POSTGRES_USER=mm_rag
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://mm_rag:replace-with-a-local-only-password@127.0.0.1:5433/mm_rag_phase2

# Qdrant
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=mm_rag_phase2
QDRANT_HTTP_PORT=6335
QDRANT_GRPC_PORT=6336
