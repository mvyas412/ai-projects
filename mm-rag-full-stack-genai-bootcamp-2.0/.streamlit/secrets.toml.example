# Copy this file to .streamlit/secrets.toml and replace every placeholder.
# The real secrets.toml is ignored and must never be committed.

[auth]
redirect_uri = "http://localhost:8502/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
expose_tokens = "access"

[auth.auth0]
client_id = "replace-with-auth0-client-id"
client_secret = "replace-with-auth0-client-secret"
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"
client_kwargs = { audience = "https://api.mm-rag.local", scope = "openid profile email" }

[app]
api_url = "http://127.0.0.1:8000"
