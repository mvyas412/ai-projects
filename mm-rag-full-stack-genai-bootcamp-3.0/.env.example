# Application
APP_NAME=MM-RAG API
APP_VERSION=3.0.0
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
MM_RAG_API_URL=http://127.0.0.1:8003

# Auth0 API validation (safe identifiers only; no client secret belongs here)
# AUTH0_ISSUER must end in / and match the token's iss claim exactly.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=
AUTH0_JWKS_CACHE_SECONDS=300
AUTH0_JWKS_TIMEOUT_SECONDS=5

# Temporary baseline adapter; Milestone 3.1 will replace it with object storage.
LOCAL_STORAGE_ROOT=data/runtime/storage
MAX_UPLOAD_BYTES=26214400

# OpenAI (set real values only in the ignored .env file)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_DB=mm_rag_phase3
POSTGRES_USER=mm_rag
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://mm_rag:replace-with-a-local-only-password@127.0.0.1:5434/mm_rag_phase3
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Qdrant
QDRANT_URL=http://127.0.0.1:6337
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=mm_rag_phase3
QDRANT_HTTP_PORT=6337
QDRANT_GRPC_PORT=6338
QDRANT_TIMEOUT_SECONDS=3
