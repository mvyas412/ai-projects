# Application
APP_NAME=MM-RAG API
APP_VERSION=3.0.0
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
MM_RAG_API_URL=http://127.0.0.1:8003

# Auth0 API validation (safe identifiers only; no client secret belongs here)
# AUTH0_ISSUER must end in / and match the token's iss claim exactly.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=
AUTH0_JWKS_CACHE_SECONDS=300
AUTH0_JWKS_TIMEOUT_SECONDS=5

# Object storage. The checked-in values are localhost-only development examples,
# not production credentials. Put real values only in the ignored .env file.
LOCAL_STORAGE_ROOT=data/runtime/storage
MAX_UPLOAD_BYTES=26214400
OBJECT_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mmrag-local-dev
S3_SECRET_ACCESS_KEY=mmrag-local-dev-only
S3_ORIGINALS_BUCKET=mm-rag-phase3-originals
S3_ARTIFACTS_BUCKET=mm-rag-phase3-artifacts
S3_PATH_STYLE=true
# Leave blank for local SeaweedFS. Production requires AES256 or aws:kms.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=30
S3_PORT=8333

# RabbitMQ. These are localhost-only development examples. Shared environments
# must override them in ignored secret configuration.
RABBITMQ_USER=mmrag-local-dev
RABBITMQ_PASSWORD=mmrag-local-dev-only
RABBITMQ_VHOST=mm_rag_phase3
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://mmrag-local-dev:mmrag-local-dev-only@127.0.0.1:5673/mm_rag_phase3
RABBITMQ_EXCHANGE=mm-rag.ingestion
RABBITMQ_QUEUE=mm-rag.ingestion.jobs
RABBITMQ_ROUTING_KEY=ingestion.job.available
RABBITMQ_DEAD_LETTER_EXCHANGE=mm-rag.ingestion.dlx
RABBITMQ_DEAD_LETTER_QUEUE=mm-rag.ingestion.dead
RABBITMQ_DEAD_LETTER_ROUTING_KEY=ingestion.job.dead
RABBITMQ_CONNECT_TIMEOUT_SECONDS=5
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
DISPATCHER_BATCH_SIZE=50
DISPATCHER_LEASE_SECONDS=30
DISPATCHER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_SHUTDOWN_SECONDS=120
WORKER_RECOVERY_POLL_SECONDS=15
RUNTIME_HEALTH_DIRECTORY=data/runtime/health
OUTBOX_TERMINAL_RETENTION_DAYS=30
OUTBOX_ALERT_ATTEMPTS=10
OUTBOX_ALERT_AGE_SECONDS=900

# Phase 4 lifecycle policy. Shortening any window requires an owner-visible
# preview and an audited apply; no purge runs automatically.
LIFECYCLE_POLICY_REVISION=phase4-retention-v1
DOCUMENT_TOMBSTONE_RETENTION_DAYS=30
CONVERSATION_TOMBSTONE_RETENTION_DAYS=30
INACTIVE_GENERATION_RETENTION_DAYS=30
ORPHAN_OBJECT_RETENTION_DAYS=7
TERMINAL_JOB_RETENTION_DAYS=90
SECURITY_AUDIT_RETENTION_DAYS=365

# OpenAI (set real values only in the ignored .env file)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_DB=mm_rag_phase3
POSTGRES_USER=mm_rag
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://mm_rag:replace-with-a-local-only-password@127.0.0.1:5434/mm_rag_phase3
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Qdrant
QDRANT_URL=http://127.0.0.1:6337
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=mm_rag_phase3
QDRANT_HTTP_PORT=6337
QDRANT_GRPC_PORT=6338
QDRANT_TIMEOUT_SECONDS=3
RAG_RETRIEVAL_PROFILE=hybrid-v1
RAG_SPARSE_INDEXING_ENABLED=true
RAG_DENSE_CANDIDATE_LIMIT=30
RAG_SPARSE_CANDIDATE_LIMIT=30
RAG_FUSION_K=60
RAG_MAX_CANDIDATES_PER_DOCUMENT=3
RAG_RERANK_CANDIDATE_LIMIT=20
RAG_RERANK_TIMEOUT_SECONDS=2
RAG_RERANK_MAX_CHARACTERS=4000
RAG_MODEL_THREADS=2
PHASE5_MODEL_CACHE_DIR=data/runtime/models

# Phase 6 remains opt-in until its quality and browser gates pass. Prefetch and
# checksum-verify Docling artifacts before enabling this local-only pipeline.
PHASE6_VISUAL_ENABLED=false
PHASE6_EXTRACTION_PROFILE=structural-v1
PHASE6_DOCLING_ARTIFACTS_PATH=data/runtime/docling-models
PHASE6_DOCLING_TIMEOUT_SECONDS=300
PHASE6_IMAGE_SCALE=2.0
PHASE6_MAX_PAGES=250
PHASE6_VISUAL_COLLECTION_NAME=mm_rag_phase3_visual
PHASE6_VISUAL_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32
PHASE6_VISUAL_EMBEDDING_REVISION=phase6-clip-v1
