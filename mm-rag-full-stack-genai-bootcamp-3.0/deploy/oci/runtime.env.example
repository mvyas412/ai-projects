# Copy to runtime.env on the OCI host. Keep runtime.env mode 0600 and outside Git.
MM_RAG_HOSTNAME=mm-rag.example.invalid
ACME_EMAIL=operator@example.invalid
STREAMLIT_SECRETS_FILE=./streamlit-secrets.toml

# Every image must be immutable. Replace each example digest before deployment.
MM_RAG_IMAGE=ghcr.io/mvyas412/mm-rag-phase8@sha256:REPLACE_WITH_64_HEX_DIGEST
NEXT_CANDIDATE_IMAGE=ghcr.io/mvyas412/mm-rag-phase8-next@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_HEX_DIGEST
QDRANT_IMAGE=qdrant/qdrant@sha256:REPLACE_WITH_64_HEX_DIGEST
SEAWEEDFS_IMAGE=chrislusf/seaweedfs@sha256:REPLACE_WITH_64_HEX_DIGEST
RABBITMQ_IMAGE=rabbitmq@sha256:REPLACE_WITH_64_HEX_DIGEST
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_64_HEX_DIGEST
LGTM_IMAGE=grafana/otel-lgtm@sha256:REPLACE_WITH_64_HEX_DIGEST
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib@sha256:REPLACE_WITH_64_HEX_DIGEST

POSTGRES_DB=mm_rag_phase8
POSTGRES_USER=mm_rag
POSTGRES_PASSWORD=
RABBITMQ_USER=mm_rag
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=mm_rag_phase8
S3_REGION=REPLACE_AFTER_OCI_HOME_REGION_SELECTION
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ORIGINALS_BUCKET=mm-rag-phase8-originals
S3_ARTIFACTS_BUCKET=mm-rag-phase8-artifacts
OPENAI_API_KEY=
GRAFANA_ADMIN_PASSWORD=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TELEMETRY_ENABLED=false

# Next.js candidate only. Leave MM_RAG_UI_UPSTREAM on Streamlit unless promotion is approved.
MM_RAG_UI_UPSTREAM=ui:8503
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
