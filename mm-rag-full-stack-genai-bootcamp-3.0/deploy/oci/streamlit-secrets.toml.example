# Copy to streamlit-secrets.toml on the OCI host. Never commit the populated file.
[auth]
redirect_uri = "https://mm-rag.example.invalid/oauth2callback"
cookie_secret = ""
expose_tokens = "access"

[auth.auth0]
client_id = ""
client_secret = ""
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"
authorize_params = { audience = "https://api.mm-rag.local" }
client_kwargs = { scope = "openid profile email" }

[app]
api_url = "http://api:8003"
