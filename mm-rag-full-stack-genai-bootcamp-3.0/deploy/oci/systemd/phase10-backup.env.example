# Copy to ignored operations/private/phase10-backup.env with mode 0600.
# The age recipient is public; keep the private identity offline from the daily host.
PHASE10_BACKUP_WORK_DIRECTORY=/opt/mm-rag/operations/private/backup-work
PHASE10_BACKUP_OUTPUT_DIRECTORY=/opt/mm-rag/operations/private/encrypted-backups
PHASE10_BACKUP_RECIPIENT_FILE=/opt/mm-rag/operations/private/age-recipient.txt
PHASE10_OCI_BACKUP_BUCKET=
PHASE10_CERTIFICATE_HOST=
